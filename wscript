import hashlib
import json
import os.path
import re
import sys

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


# Telegram API credentials (https://my.telegram.org/apps) are injected at build
# time from the environment into a generated module, build/js/
# squire_telegram_app.js, which the phone-side JS requires. They are never
# committed. A build without them fails unless explicitly allowed, in which
# case the app reports "not configured" instead of trying to sign in with
# invalid credentials. Values are never printed.
TELEGRAM_CONFIG_MODULE = 'js/squire_telegram_app.js'


def _telegram_app_config(ctx):
    app_id = os.environ.get('TELEGRAM_APP_ID', '').strip()
    app_hash = os.environ.get('TELEGRAM_APP_HASH', '').strip()
    allow_missing = os.environ.get('SQUIRE_ALLOW_UNCONFIGURED_TELEGRAM', '') == '1'
    if not app_id and not app_hash:
        if not allow_missing:
            ctx.fatal('TELEGRAM_APP_ID and TELEGRAM_APP_HASH are not set. Export them (from '
                      'https://my.telegram.org/apps) before building, or set '
                      'SQUIRE_ALLOW_UNCONFIGURED_TELEGRAM=1 to build an app that cannot sign in.')
        print('WARNING: building without Telegram API credentials; the app will report '
              'that it is not configured.')
        return {'configured': False, 'apiId': 0, 'apiHash': ''}
    if not re.match(r'^[1-9][0-9]{0,11}$', app_id):
        ctx.fatal('TELEGRAM_APP_ID must be a positive integer (value not shown).')
    if not re.match(r'^[0-9a-fA-F]{32}$', app_hash):
        ctx.fatal('TELEGRAM_APP_HASH must be 32 hexadecimal characters (value not shown).')
    return {'configured': True, 'apiId': int(app_id), 'apiHash': app_hash.lower()}


def _write_telegram_config(task):
    config = task.generator.telegram_config
    task.outputs[0].write(
        '// Generated by wscript at build time. Do not edit or commit.\n'
        'module.exports = ' + json.dumps(config, sort_keys=True) + ';\n')


def build(ctx):
    ctx.load('pebble_sdk')

    build_worker = os.path.exists('worker_src')
    binaries = []

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)

        ctx.pbl_build(
            source=ctx.path.ant_glob(['src/c/**/*.c']),
            target=app_elf,
            bin_type='app')

        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform, 'app_elf': app_elf, 'worker_elf': worker_elf})
            ctx.pbl_build(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                          target=worker_elf,
                          bin_type='worker')
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx(features='subst',
        source='package.json',
        target='js/package.json',
        is_copy=True)

    telegram_config = _telegram_app_config(ctx)
    # Only a digest goes into the task signature, so a credential change
    # triggers a rebuild without the values being stored in waf's cache.
    ctx.env.SQUIRE_TELEGRAM_CONFIG_DIGEST = hashlib.sha256(
        json.dumps(telegram_config, sort_keys=True).encode('utf-8')).hexdigest()
    config_node = ctx.path.get_bld().make_node(TELEGRAM_CONFIG_MODULE)
    ctx(rule=_write_telegram_config,
        target=config_node,
        vars=['SQUIRE_TELEGRAM_CONFIG_DIGEST'],
        telegram_config=telegram_config)

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json',
                                         'src/common/**/*.js']) + [config_node],
                   js_entry_file='src/pkjs/index.js')
